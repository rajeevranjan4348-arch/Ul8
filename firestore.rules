rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to extract incoming document payload
    function incoming() {
      return request.resource.data;
    }

    // Secure helper to validate voice commands
    function isValidVoiceCommand(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.source is string && data.source.size() <= 128 &&
             data.text is string && data.text.size() <= 10000 &&
             data.updatedAt is number &&
             (!('messages' in data) || (data.messages is list && data.messages.size() <= 100));
    }

    // Secure helper to validate voice sessions
    function isValidVoiceSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.status is string && data.status.size() <= 128 &&
             data.duration is string && data.duration.size() <= 128 &&
             data.updatedAt is number;
    }

    match /users/{userId}/workspace_logs/{logId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /users/{userId}/keep_notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/voice_commands/{commandId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && isValidVoiceCommand(incoming());
    }

    match /users/{userId}/voice_sessions/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && isValidVoiceSession(incoming());
    }
  }
}
